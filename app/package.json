{
  "name": "covelet",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:extension": "wxt --browser chrome --mv3",
    "build": "node scripts/build-wasm.mjs --check && node scripts/build-sync-wasm.mjs --check && node scripts/build-github-wasm.mjs --check && node scripts/clock-wasm.mjs --check && node scripts/build-tools-wasm.mjs --check && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:onboarding": "node tests/onboarding-extension.mjs",
    "test:bookmarks": "node tests/bookmarks-extension.mjs",
    "test": "node scripts/build-wasm.mjs --check && node scripts/build-sync-wasm.mjs --check && node scripts/build-github-wasm.mjs --check && node --import ./tests/test-language.mjs --test src/lib/*.test.js",
    "check:wasm": "node scripts/build-wasm.mjs --check && node scripts/build-sync-wasm.mjs --check && node scripts/build-github-wasm.mjs --check && node scripts/clock-wasm.mjs --check && node scripts/build-tools-wasm.mjs --check",
    "generate:clock-wasm": "node scripts/clock-wasm.mjs --write",
    "build:wasm": "node scripts/build-wasm.mjs --rebuild",
    "build:sync-wasm": "node scripts/build-sync-wasm.mjs --rebuild",
    "build:unpacked": "node scripts/build-extension.mjs --unpacked",
    "build:extension": "node scripts/build-extension.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "build:github-wasm": "node scripts/build-github-wasm.mjs --rebuild",
    "generate:tools-wasm": "node scripts/build-tools-wasm.mjs --generate",
    "generate:i18n": "node scripts/localize-source.mjs --catalog",
    "test:e2e": "playwright test",
    "test:upgrade": "node tests/upgrade/prepare-packages.mjs && playwright test --config tests/playwright-upgrade.config.mjs",
    "test:live-privacy": "node tests/live-privacy-check.mjs",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:report": "playwright show-report ../output/playwright/covelet/report"
  },
  "dependencies": {
    "@futelab/folio": "0.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "26.1.0",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=22"
  }
}
